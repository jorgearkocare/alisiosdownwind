---
import ReportIssue from "../../components/ReportIssue.astro";
import { issues } from "../../report/issues";

export function getStaticPaths() {
  return issues.map((issue) => ({ params: { slug: issue.slug }, props: { issue } }));
}

const { issue } = Astro.props;
---

<ReportIssue issue={issue} />
