---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import Logo from "../components/Logo.astro";
import { btnPrimary, container, sticker } from "../ui";
---

<Layout title="Página no encontrada" noindex>
  <section class="flex min-h-[80dvh] items-center pb-24 pt-24">
    <div class={`${container} mt-16 grid items-center gap-12 md:grid-cols-12`}>
      <div class="md:col-span-7">
      <p class={`${sticker} -rotate-2`}>Error 404</p>
      <h1 class="mt-6 max-w-[680px] font-display text-6xl uppercase leading-none md:text-8xl">
        Esta página se la ha llevado el viento
      </h1>
      <p class="mt-6 max-w-[680px] text-lg text-ink/70">
        Puede que el enlace esté mal escrito o que la página ya no exista. Vuelve al inicio y sigue desde la salida.
      </p>
      <a href="/" class={`${btnPrimary} mt-8`}>
        <Icon name="arrowLeft" class="size-4" />
        <span>Volver al inicio</span>
      </a>
      </div>
      <div class="md:col-span-5">
        <Logo class="mx-auto h-auto w-full max-w-[320px] rotate-12" alt="" />
      </div>
    </div>
  </section>
</Layout>
