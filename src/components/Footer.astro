---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import Sticker from "./Sticker.astro";
import Torn from "./Torn.astro";
import { site } from "../config";
import { container } from "../ui";
import { useI18n } from "../i18n";

interface Props {
  current?: string;
}

const { current = "" } = Astro.props;
const { t, home } = useI18n(Astro.url);
const f = t.footer;
const year = new Date().getFullYear();
const link =
  "inline-flex items-center gap-2 rounded-sm text-sm text-cream/70 transition-colors duration-700 ease-fluid hover:text-sun aria-[current=page]:text-sun";
---

<footer class="relative mt-6 bg-ink pt-16 text-cream">
  <Torn />
  <Sticker text="Never ride alone" class="absolute -top-5 right-4 z-20 rotate-3 md:right-12" />
  <div class={`${container} grid gap-12 md:grid-cols-12`}>
    <div class="md:col-span-6">
      <a href={home} class="inline-flex items-center gap-4" aria-label={t.nav.home}>
        <Logo class="size-16 shrink-0" />
        <span class="font-display text-4xl uppercase leading-none">Alisios DW</span>
      </a>
      <p class="mt-6 max-w-[680px] text-sm text-cream/60">
        {f.blurb}
      </p>
      <p class="mt-2 text-sm text-cream/60">{f.contact}</p>
    </div>

    <nav aria-label={f.community} class="md:col-span-3">
      <p class="text-sm font-semibold uppercase tracking-wide text-sun">{f.community}</p>
      <ul class="mt-4 space-y-2">
        <li>
          <a href={site.instagram} target="_blank" rel="noopener" class={link}>
            <Icon name="instagram" class="size-4" />
            <span>Instagram</span>
          </a>
        </li>
        {
          site.whatsappGroup && (
            <li>
              <a href={site.whatsappGroup} target="_blank" rel="noopener" class={link}>
                <Icon name="whatsapp" class="size-4" />
                <span>{f.whatsapp}</span>
              </a>
            </li>
          )
        }
        <li>
          <a href={`mailto:${site.email}`} class={link}>
            <Icon name="envelope" class="size-4" />
            <span>{site.email}</span>
          </a>
        </li>
      </ul>
    </nav>

    <nav aria-label={f.legal} class="md:col-span-3">
      <p class="text-sm font-semibold uppercase tracking-wide text-sun">{f.legal}</p>
      <ul class="mt-4 space-y-2">
        <li><a href="/privacidad" aria-current={current === "privacidad" ? "page" : undefined} class={link}>{f.privacy} {f.legalLangNote}</a></li>
        <li><a href="/aviso-legal" aria-current={current === "aviso-legal" ? "page" : undefined} class={link}>{f.legalNotice} {f.legalLangNote}</a></li>
      </ul>
    </nav>
  </div>

  <div class={`${container} mt-12 flex flex-wrap items-center justify-between gap-4 text-xs text-cream/50`}>
    <p>© {year} Alisios Downwind</p>
    <p>{f.madeIn}</p>
  </div>

  <div class="mt-12 overflow-hidden" aria-hidden="true">
    <svg viewBox="0 0 1000 170" class="block w-full translate-y-6 text-sun">
      <text x="500" y="160" text-anchor="middle" textLength="980" lengthAdjust="spacingAndGlyphs" font-family="Anton, 'Arial Narrow', Impact, sans-serif" font-size="190" fill="currentColor">ALISIOS DW</text>
    </svg>
  </div>
</footer>
