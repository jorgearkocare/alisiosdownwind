---
import Icon from "./Icon.astro";
import type { IconName } from "../icons";
import { container, eyebrow, h2, section } from "../ui";

const steps: { icon: IconName; title: string; text: string }[] = [
  {
    icon: "users",
    title: "Únete a la comunidad",
    text: "Déjanos tu email y entra al grupo de WhatsApp. Ahí se mueve todo.",
  },
  {
    icon: "bell",
    title: "Recibe el aviso",
    text: "Cuando el parte confirma viento anunciamos ruta, hora, punto de encuentro y nivel, normalmente con uno o dos días de margen.",
  },
  {
    icon: "path",
    title: "Baja en grupo",
    text: "Dejamos coches en la llegada, subimos juntos a la salida y bajamos con el alisio a la espalda.",
  },
];
---

<section id="como-funciona" aria-labelledby="como-funciona-title" class={section}>
  <div class={container}>
    <p data-reveal class={eyebrow}>Cómo funciona</p>
    <h2 id="como-funciona-title" data-reveal style="--d: 80ms" class={h2}>De tu sofá a la llegada en tres pasos</h2>

    <ol class="mt-12 grid gap-6 md:grid-cols-3">
      {
        steps.map((step, i) => (
          <li data-reveal style={`--d: ${120 + i * 80}ms`} class="rounded-3xl border border-white/10 p-6">
            <div class="flex items-center justify-between">
              <span class="text-sm font-semibold tabular-nums text-foam">{`0${i + 1}`}</span>
              <Icon name={step.icon} class="size-6 text-white/50" />
            </div>
            <h3 class="mt-8 text-xl font-semibold">{step.title}</h3>
            <p class="mt-2 text-base text-white/70">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
