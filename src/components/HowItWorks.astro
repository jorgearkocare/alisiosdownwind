---
import Icon from "./Icon.astro";
import type { IconName } from "../icons";
import { container, h2, section, sticker } from "../ui";

const steps: { icon: IconName; title: string; text: string }[] = [
  {
    icon: "users",
    title: "Únete a la comunidad",
    text: "Déjanos tu email y entra al grupo de WhatsApp. Ahí se mueve todo.",
  },
  {
    icon: "bell",
    title: "Recibe el aviso",
    text: "Cuando el parte confirma viento anunciamos ruta, hora, punto de encuentro y nivel, normalmente con uno o dos días de margen.",
  },
  {
    icon: "path",
    title: "Baja en grupo",
    text: "Dejamos coches en la llegada, subimos juntos a la salida y bajamos con el alisio a la espalda.",
  },
];
---

<section id="como-funciona" aria-labelledby="como-funciona-title" class={section}>
  <div class={container}>
    <p data-reveal class={`${sticker} rotate-1`}>Cómo funciona</p>
    <h2 id="como-funciona-title" data-reveal style="--d: 80ms" class={h2}>Del sofá a la llegada en tres pasos</h2>

    <ol class="mt-12 grid gap-12 md:grid-cols-3 md:gap-8">
      {
        steps.map((step, i) => (
          <li data-reveal style={`--d: ${120 + i * 80}ms`}>
            <div class="flex items-end justify-between border-b-2 border-ink pb-4">
              <span class="text-outline font-display text-8xl leading-none tabular-nums">{`0${i + 1}`}</span>
              <span class="flex size-12 items-center justify-center rounded-full border-2 border-ink bg-sun">
                <Icon name={step.icon} class="size-6" />
              </span>
            </div>
            <h3 class="mt-6 font-display text-3xl uppercase leading-none">{step.title}</h3>
            <p class="mt-4 text-base text-ink/70">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
