---
import Icon from "./Icon.astro";
import Sticker from "./Sticker.astro";
import { site } from "../config";
import { btnPrimary, container } from "../ui";
import { useI18n } from "../i18n";

// Para apuntarse a un run basta con entrar al grupo de WhatsApp (enlace en src/config.ts, whatsappGroup).
const { t } = useI18n(Astro.url);
const j = t.join;
---

<section id="unete" aria-labelledby="unete-title" class="border-y-2 border-ink bg-blue py-24">
  <div class={container}>
    <div class="grid gap-12 rounded-2xl border-2 border-ink bg-cream p-6 shadow-hard md:p-12 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <h2 id="unete-title" data-reveal class="font-display text-5xl uppercase leading-none md:text-7xl">
          {j.title}
        </h2>
        <p data-reveal style="--d: 80ms" class="mt-6 text-lg text-ink/70">
          {j.lead}
        </p>
        <ul data-reveal style="--d: 160ms" class="mt-8 space-y-4">
          {
            j.perks.map((perk) => (
              <li class="flex items-center gap-2 text-base font-medium">
                <Icon name="check" class="size-5 shrink-0 text-blue" />
                <span>{perk}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div data-reveal style="--d: 200ms" class="lg:col-span-6">
        <div class="relative rounded-2xl border-2 border-ink bg-sun p-5 shadow-hard md:p-8">
          <Sticker text="Join the crew" tone="paper" class="absolute -right-3 -top-5 rotate-6" />
          <p class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wide">
            <Icon name="whatsapp" class="size-5" />
            <span>{j.stepsLabel}</span>
          </p>
          <ol class="mt-6 space-y-6">
            {
              j.steps.map((step, i) => (
                <li class="flex items-start gap-4">
                  <span class="flex size-10 shrink-0 items-center justify-center rounded-full border-2 border-ink bg-paper font-display text-xl leading-none" aria-hidden="true">{i + 1}</span>
                  <p class="pt-2 text-base font-medium">{step}</p>
                </li>
              ))
            }
          </ol>
          <a href={site.whatsappGroup} target="_blank" rel="noopener" class={`${btnPrimary.replace("px-3 py-2", "px-5 py-4").replace("text-base", "text-base sm:text-lg")} mt-8 w-full sm:w-auto`}>
            <Icon name="whatsapp" class="size-6" />
            <span>{j.cta}</span>
          </a>
          <p class="mt-4 text-sm text-ink/70">{j.note}</p>
        </div>
      </div>
    </div>
  </div>
</section>
