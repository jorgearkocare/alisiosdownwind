---
import Icon from "./Icon.astro";
import type { IconName } from "../icons";
import { container, h2, lead, section, sticker } from "../ui";

const services: { icon: IconName; title: string; text: string; interest: string }[] = [
  {
    icon: "lifebuoy",
    title: "Rescate y buenas prácticas",
    interest: "cursos",
    text: "Autorescate, remolque, señales y plan de ruta. Teoría y agua en una mañana.",
  },
  {
    icon: "waves",
    title: "Iniciación a SUP foil",
    interest: "cursos",
    text: "Despegar a remo con choppy y enlazar tus primeros bumps, con un coach para cada dos riders.",
  },
  {
    icon: "wind",
    title: "Clases de parawing",
    interest: "cursos",
    text: "Para pasar del wing al parawing con alguien al lado que ya ha recorrido ese camino.",
  },
  {
    icon: "path",
    title: "Runs con paradas",
    interest: "cursos",
    text: "Tramos cortos en grupo, con paradas para corregir técnica sobre la marcha.",
  },
  {
    icon: "compass",
    title: "Pro run",
    interest: "pro-run-filmacion",
    text: "Un rider profesional hace el downwind contigo de punta a punta y te enseña su línea.",
  },
  {
    icon: "video",
    title: "Filmación de tu run",
    interest: "pro-run-filmacion",
    text: "Te grabamos desde el agua o desde moto de agua para que veas qué corregir.",
  },
];
---

<section id="lo-que-viene" aria-labelledby="lo-que-viene-title" class={section}>
  <div class={container}>
    <p data-reveal class={`${sticker} rotate-1`}>Lo que viene</p>
    <h2 id="lo-que-viene-title" data-reveal style="--d: 80ms" class={h2}>Cursos, pro runs y filmación</h2>
    <p data-reveal style="--d: 160ms" class={lead}>
      Lo estamos preparando como club, con seguro y monitores titulados. Marca lo que te interesa al apuntarte y te avisamos antes que a nadie.
    </p>

    <ul class="mt-12 border-t-2 border-ink">
      {
        services.map((item) => (
          <li data-reveal class="border-b-2 border-ink">
            <a href="#unete" data-interest={item.interest} class="group grid items-center gap-4 px-2 py-6 transition-colors duration-700 ease-fluid hover:bg-sun md:grid-cols-12 md:px-4">
              <span class="flex items-center gap-4 md:col-span-5">
                <Icon name={item.icon} class="size-8 shrink-0 text-blue transition-transform duration-700 ease-fluid group-hover:-rotate-12" />
                <span class="font-display text-3xl uppercase leading-none md:text-4xl">{item.title}</span>
              </span>
              <span class="text-base text-ink/70 md:col-span-5">{item.text}</span>
              <span class="md:col-span-2 md:text-right">
                <span class="inline-block rounded-full border-2 border-ink bg-paper px-2 py-0.5 text-xs font-semibold uppercase tracking-wide">Próximamente</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
