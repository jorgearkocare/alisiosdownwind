---
import Icon from "./Icon.astro";
import type { IconName } from "../icons";
import { container, h2, lead, section, sticker } from "../ui";
import { useI18n } from "../i18n";

const { t, home } = useI18n(Astro.url);
const meta: { icon: IconName; interest: string }[] = [
  { icon: "lifebuoy", interest: "cursos" },
  { icon: "waves", interest: "cursos" },
  { icon: "wind", interest: "cursos" },
  { icon: "path", interest: "cursos" },
  { icon: "compass", interest: "pro-run-filmacion" },
  { icon: "video", interest: "pro-run-filmacion" },
];
const services = t.coming.items.map((item, i) => ({ ...item, ...meta[i] }));
---

<section id="lo-que-viene" aria-labelledby="lo-que-viene-title" class={section}>
  <div class={container}>
    <p data-reveal class={`${sticker} rotate-1`}>{t.coming.sticker}</p>
    <h2 id="lo-que-viene-title" data-reveal style="--d: 80ms" class={h2}>{t.coming.title}</h2>
    <p data-reveal style="--d: 160ms" class={lead}>
      {t.coming.lead}
    </p>

    <ul class="mt-12 border-t-2 border-ink">
      {
        services.map((item) => (
          <li data-reveal class="border-b-2 border-ink">
            <a href={`${home}#unete`} data-interest={item.interest} class="group grid items-center gap-4 px-2 py-6 transition-colors duration-700 ease-fluid hover:bg-sun md:grid-cols-12 md:px-4">
              <span class="flex items-center gap-4 md:col-span-5">
                <Icon name={item.icon} class="size-8 shrink-0 text-blue transition-transform duration-700 ease-fluid group-hover:-rotate-12" />
                <span class="font-display text-3xl uppercase leading-none md:text-4xl">{item.title}</span>
              </span>
              <span class="text-base text-ink/70 md:col-span-5">{item.text}</span>
              <span class="md:col-span-2 md:text-right">
                <span class="inline-block rounded-full border-2 border-ink bg-paper px-2 py-0.5 text-xs font-semibold uppercase tracking-wide">{t.coming.soon}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
