---
import Icon from "./Icon.astro";
import { container, h2, lead, section, sticker } from "../ui";
import { useI18n } from "../i18n";
import Sticker from "./Sticker.astro";

const { t, lang } = useI18n(Astro.url);

// Los cuatro amigos que empezaron Alisios. Para cambiar el orden o añadir a alguien, edita esta lista.
// Las fotos están en public/equipo/ con el nombre de usuario de Instagram.
const people = [
  { name: "Jorge", handle: "joorgee_z" },
  { name: "Liam", handle: "liamdm11" },
  { name: "Mike", handle: "mike_e255" },
  { name: "Marino", handle: "marinito959" },
];
const looks = [
  { card: "bg-sun", badge: "bg-paper text-ink", tilt: "-rotate-2" },
  { card: "bg-blue text-cream", badge: "bg-sun text-ink", tilt: "rotate-1" },
  { card: "bg-ink text-cream", badge: "bg-blue text-cream", tilt: "-rotate-1" },
  { card: "bg-paper", badge: "bg-ink text-cream", tilt: "rotate-2" },
];
const crew = people.map((p, i) => ({ ...p, photo: `/equipo/${p.handle}.jpg`, url: `https://www.instagram.com/${p.handle}/`, ...looks[i] }));
// Se repiten las tarjetas para que el carrusel cubra pantallas anchas sin huecos
const loop = [...crew, ...crew, ...crew];

// Muro de fotos del crew (public/equipo/crew/). Pies de foto y textos alternativos en src/i18n, en team.wall.items, en este orden.
const wallFiles = [
  { src: "rumbo-a-la-salida", h: 1138 },
  { src: "run-completado", h: 853 },
  { src: "preparando-material-en-pozo", h: 853 },
  { src: "listos-para-remar", h: 1138 },
  { src: "atardecer-en-la-furgo", h: 853 },
  { src: "antes-de-salir", h: 853 },
  { src: "revisando-la-gopro", h: 853 },
  { src: "cafe-de-despues", h: 1138 },
  { src: "de-vuelta-en-tierra", h: 854 },
];
const frames = ["bg-paper", "bg-sun", "bg-paper", "bg-blue text-cream", "bg-paper", "bg-ink text-cream", "bg-sun", "bg-paper", "bg-blue text-cream"];
const tilts = ["-rotate-2", "rotate-1", "-rotate-1", "rotate-2", "-rotate-1", "rotate-1", "-rotate-2", "rotate-1", "-rotate-1"];
const wall = wallFiles.map((f, i) => ({ ...f, src: `/equipo/crew/${f.src}.jpg`, ...t.team.wall.items[i], frame: frames[i], tilt: tilts[i] }));
// Ruta GPS del downwind del 12 de mayo de 2026 (Waterspeed)
const w = t.team.wall;
const num = (n: number) => new Intl.NumberFormat(lang, { maximumFractionDigits: 1 }).format(n);
const routeStats = [
  { value: num(22.8), unit: "km", label: w.distance },
  { value: num(16.4), unit: w.knots, label: w.max },
  { value: num(7.7), unit: w.knots, label: w.avg },
];
---

<section id="equipo" aria-labelledby="equipo-title" class={section}>
  <div class={container}>
    <p data-reveal class={`${sticker} -rotate-1`}>{t.team.sticker}</p>
    <h2 id="equipo-title" data-reveal style="--d: 80ms" class={h2}>{t.team.title}</h2>
    <p data-reveal style="--d: 160ms" class={lead}>{t.team.lead}</p>

  </div>

  <!-- Carrusel: la lista se repite para que la cinta nunca se quede vacía; se para al pasar el ratón o con el teclado -->
  <div data-reveal style="--d: 120ms" class="marquee marquee-scroll mt-8 overflow-hidden py-8">
    <div class="marquee-track flex w-max" style="--speed: 100s">
      {
        [0, 1].map((copy) => (
          <ul class="flex shrink-0 gap-8 pr-8" aria-hidden={copy === 1 ? "true" : undefined} data-dup={copy === 1 ? "" : undefined}>
            {loop.map((person, i) => (
              <li class="w-64 shrink-0 sm:w-72">
                <a
                  href={person.url}
                  target="_blank"
                  rel="noopener"
                  tabindex={copy === 1 || i >= crew.length ? "-1" : undefined}
                  aria-label={`${t.team.profile} ${person.name}, @${person.handle} (Instagram)`}
                  class={`group flex h-full flex-col rounded-2xl border-2 border-ink p-2 shadow-hard transition-all duration-700 ease-fluid hover:-translate-y-1 hover:rotate-0 ${person.card} ${person.tilt}`}
                >
                  <img
                    src={person.photo}
                    width="640"
                    height="800"
                    alt={person.name}
                    loading="lazy"
                    decoding="async"
                    class="aspect-[4/5] h-auto w-full rounded-lg border-2 border-ink object-cover"
                  />
                  <span class="flex flex-1 flex-col px-2 pb-2 pt-4">
                    <span class="block font-display text-4xl uppercase leading-none">{person.name}</span>
                    <span class="mt-2 block break-all text-base font-semibold">@{person.handle}</span>
                    <span class="mt-1 block text-xs font-semibold uppercase tracking-wide opacity-70">{t.team.role}</span>
                    <span class="mt-auto flex items-center gap-2 pt-4 text-sm font-semibold">
                      <Icon name="instagram" class="size-5" />
                      <span>Instagram</span>
                      <Icon name="arrowUpRight" class="size-4 transition-transform duration-700 ease-fluid group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
  <!-- Muro del crew: fotos fuera y dentro del agua, con la ruta GPS destacada -->
  <div class={`${container} mt-16`}>
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <h3 data-reveal class="font-display text-4xl uppercase leading-none md:text-5xl">{w.title}</h3>
        <p data-reveal style="--d: 80ms" class="mt-4 text-lg text-ink/70">{w.lead}</p>
        <figure data-reveal style="--d: 160ms" class="tape relative mt-10 -rotate-1 rounded-2xl border-2 border-ink bg-ink p-2 text-cream shadow-hard lg:sticky lg:top-28">
          <Sticker text={`${num(22.8)} km`} tone="sun" class="absolute -right-3 top-6 z-10 rotate-6" />
          <img src="/equipo/crew/ruta-12-mayo.jpg" width="720" height="1280" alt={w.routeAlt} loading="lazy" decoding="async" class="h-auto w-full rounded-lg border-2 border-ink" />
          <figcaption class="px-2 pb-2 pt-4">
            <span class="block text-xs font-semibold uppercase tracking-wide text-sun">{w.routeLabel}</span>
            <span class="mt-1 block font-display text-2xl uppercase leading-none">{w.routeTitle}</span>
            <dl class="mt-4 grid grid-cols-3 gap-2 border-t-2 border-cream/20 pt-4">
              {
                routeStats.map((stat) => (
                  <div>
                    <dt class="text-xs text-cream/60">{stat.label}</dt>
                    <dd class="mt-1 font-display text-2xl leading-none">
                      {stat.value}
                      <span class="mt-1 block font-sans text-xs font-semibold uppercase tracking-wide text-cream/60">{stat.unit}</span>
                    </dd>
                  </div>
                ))
              }
            </dl>
          </figcaption>
        </figure>
      </div>

      <ul class="columns-2 gap-6 md:columns-3 lg:col-span-8">
        {
          wall.map((photo, i) => (
            <li data-reveal style={`--d: ${(i % 3) * 80}ms`} class="mb-8 break-inside-avoid pt-4">
              <figure class={`tape rounded-2xl border-2 border-ink p-2 shadow-hard transition-transform duration-700 ease-fluid md:hover:rotate-0 ${photo.frame} ${photo.tilt}`}>
                <img src={photo.src} width="640" height={photo.h} alt={photo.alt} loading="lazy" decoding="async" class="h-auto w-full rounded-lg border-2 border-ink" />
                <figcaption class="px-1 pb-1 pt-3 font-display text-lg uppercase leading-none md:text-xl">{photo.caption}</figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
