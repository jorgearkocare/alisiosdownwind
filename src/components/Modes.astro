---
import Icon from "./Icon.astro";
import type { IconName } from "../icons";
import { container, h2, lead, section, sticker } from "../ui";
import { useI18n } from "../i18n";

const { t } = useI18n(Astro.url);
const look: { icon: IconName; tone: string; tilt: string }[] = [
  { icon: "waves", tone: "bg-sun text-ink", tilt: "md:-rotate-1" },
  { icon: "wind", tone: "bg-blue text-cream", tilt: "md:rotate-1" },
  { icon: "wind", tone: "bg-ink text-cream", tilt: "md:-rotate-1" },
];
const modes = t.modes.items.map((m, i) => ({ ...m, ...look[i] }));
---

<section id="modalidades" aria-labelledby="modalidades-title" class={section}>
  <div class={container}>
    <p data-reveal class={`${sticker} -rotate-1`}>{t.modes.sticker}</p>
    <h2 id="modalidades-title" data-reveal style="--d: 80ms" class={h2}>{t.modes.title}</h2>
    <p data-reveal style="--d: 160ms" class={lead}>
      {t.modes.lead}
    </p>

    <ul class="mt-12 grid gap-8 md:grid-cols-3">
      {
        modes.map((mode, i) => (
          <li data-reveal style={`--d: ${120 + i * 80}ms`} class={`flex flex-col rounded-2xl border-2 border-ink p-6 shadow-hard transition-transform duration-700 ease-fluid md:hover:rotate-0 ${mode.tone} ${mode.tilt}`}>
            <div class="flex items-start justify-between gap-4">
              <h3 class="font-display text-5xl uppercase leading-none">{mode.name}</h3>
              <Icon name={mode.icon} class="size-8 shrink-0" />
            </div>
            <p class="mt-6 text-base opacity-80">{mode.text}</p>
            <p class="mt-6 text-sm font-semibold uppercase tracking-wide opacity-60">{t.modes.needs}</p>
            <ul class="mt-2 space-y-2">
              {mode.needs.map((need) => (
                <li class="flex items-start gap-2 text-sm font-medium">
                  <Icon name="check" class="mt-0.5 size-4 shrink-0" />
                  <span>{need}</span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>
