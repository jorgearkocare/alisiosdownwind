---
import Icon from "./Icon.astro";
import type { IconName } from "../icons";
import { container, eyebrow, h2, lead, section } from "../ui";

const modes: { icon: IconName; name: string; text: string; needs: string[] }[] = [
  {
    icon: "waves",
    name: "SUP foil",
    text: "La más pura. Despegas a remo sobre el choppy y encadenas bumps sin más tracción que la del mar.",
    needs: ["Tabla de downwind, foil y pala", "Despegar a remo con choppy"],
  },
  {
    icon: "wind",
    name: "Parawing",
    text: "Un ala sin botavara que te da el empujón para despegar y que recoges para surfear el swell.",
    needs: ["Tabla, foil y parawing", "Soltura navegando con ala"],
  },
  {
    icon: "sailboat",
    name: "Wing foil",
    text: "Tracción constante para enlazar swells y volver a despegar si te caes a mitad de ruta.",
    needs: ["Tabla, foil y wing", "Navegar a favor del viento"],
  },
];
---

<section id="modalidades" aria-labelledby="modalidades-title" class={section}>
  <div class={container}>
    <p data-reveal class={eyebrow}>Modalidades</p>
    <h2 id="modalidades-title" data-reveal style="--d: 80ms" class={h2}>Tres maneras de bajar el mismo viento</h2>
    <p data-reveal style="--d: 160ms" class={lead}>
      En cada aviso indicamos para qué modalidades es la ruta. Muchas bajadas juntan riders de las tres.
    </p>

    <ul class="mt-12 grid gap-6 md:grid-cols-3">
      {
        modes.map((mode, i) => (
          <li data-reveal style={`--d: ${120 + i * 80}ms`} class="rounded-3xl border border-white/10 bg-coal p-2">
            <div class="flex h-full flex-col rounded-2xl bg-slate p-6">
              <div class="flex items-center justify-between">
                <h3 class="text-2xl font-semibold">{mode.name}</h3>
                <Icon name={mode.icon} class="size-6 text-foam" />
              </div>
              <p class="mt-4 text-base text-white/70">{mode.text}</p>
              <p class="mt-6 text-sm font-semibold text-white/50">Qué necesitas</p>
              <ul class="mt-2 space-y-2">
                {mode.needs.map((need) => (
                  <li class="flex items-start gap-2 text-sm text-white">
                    <Icon name="check" class="mt-0.5 size-4 shrink-0 text-foam" />
                    <span>{need}</span>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
