---
import Icon from "./Icon.astro";
import { site } from "../config";
import { btnSecondary, container, h2, stickerBase } from "../ui";

// Riders que ya han hecho downwind con la comunidad. Añade aquí más nombres (con su permiso).
const riders = [
  { name: "Iballa Ruano", role: "Rider profesional de Gran Canaria" },
  { name: "Foil Only", role: "Escuela y comunidad de foil de Tenerife" },
  { name: "Moritz Mauch", role: "" },
  { name: "Miguel Chapuis", role: "" },
];

// Fotos sacadas del Instagram de la comunidad. Para cambiarlas, sustituye los archivos de public/fotos/
const photos = [
  { src: "/fotos/run-en-el-agua.jpg", w: 388, h: 447, caption: "En el agua", alt: "Dos riders de SUP foil en pleno downwind sobre el mar azul, uno con chaleco rosa remando y otro saludando" },
  { src: "/fotos/antes-del-run.jpg", w: 388, h: 447, caption: "Antes del run", alt: "Selfie del grupo junto a la furgoneta con las tablas y los foils preparados antes de salir" },
  { src: "/fotos/despues-del-run.jpg", w: 385, h: 447, caption: "Después del run", alt: "El grupo celebrando en la llegada con una tabla de downwind morada y cervezas en la mano" },
];
---

<section aria-labelledby="comunidad-title" class="border-y-2 border-ink bg-sun py-24">
  <div class={container}>
    <div class="grid gap-12 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p data-reveal class={`${stickerBase} -rotate-2 bg-paper`}>La comunidad</p>
        <h2 id="comunidad-title" data-reveal style="--d: 80ms" class={h2}>Empezamos unos pocos amigos. Ahora vienen hasta los pros.</h2>
        <p data-reveal style="--d: 160ms" class="mt-6 max-w-[680px] text-lg text-ink/80">
          Alisios nació para no hacer downwind solos. Hoy es un grupo abierto de riders de toda la isla, y cada run lo contamos en Instagram.
        </p>
        <div data-reveal style="--d: 240ms" class="mt-8">
          <a href={site.instagram} target="_blank" rel="noopener" class={btnSecondary}>
            <Icon name="instagram" class="size-5" />
            <span>Ver {site.instagramHandle}</span>
          </a>
        </div>
      </div>

      <div class="lg:col-span-5">
        <p data-reveal class="text-sm font-semibold uppercase tracking-wide">Han hecho downwind con nosotros</p>
        <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
          {
            riders.map((rider, i) => (
              <li data-reveal style={`--d: ${120 + i * 80}ms`} class={`flex items-center gap-4 rounded-2xl border-2 border-ink bg-paper p-4 shadow-hard ${i % 2 ? "rotate-1" : "-rotate-1"}`}>
                <span class="flex size-12 shrink-0 items-center justify-center rounded-full border-2 border-ink bg-blue font-display text-xl text-cream" aria-hidden="true">
                  {rider.name.split(" ").map((w) => w[0]).join("").slice(0, 2)}
                </span>
                <span>
                  <span class="block font-display text-2xl uppercase leading-none">{rider.name}</span>
                  {rider.role && <span class="mt-1 block text-sm text-ink/60">{rider.role}</span>}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <ul class="mt-16 grid gap-8 sm:grid-cols-3">
      {
        photos.map((photo, i) => (
          <li data-reveal style={`--d: ${i * 100}ms`} class={`${["-rotate-2", "rotate-1", "-rotate-1"][i]} transition-transform duration-700 ease-fluid hover:rotate-0`}>
            <figure class="rounded-2xl border-2 border-ink bg-paper p-2 shadow-hard">
              <img src={photo.src} width={photo.w} height={photo.h} alt={photo.alt} loading="lazy" decoding="async" class="aspect-[4/5] h-auto w-full rounded-lg border-2 border-ink object-cover" />
              <figcaption class="px-2 pb-1 pt-2 font-display text-xl uppercase leading-none">{photo.caption}</figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>
