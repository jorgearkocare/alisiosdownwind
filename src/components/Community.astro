---
import Icon from "./Icon.astro";
import { site } from "../config";
import { btnSecondary, container, h2, stickerBase } from "../ui";
import { useI18n } from "../i18n";

const { t } = useI18n(Astro.url);

// Riders que ya han hecho downwind con la comunidad. Añade aquí más nombres (con su permiso).
// La descripción de cada uno está en los diccionarios (src/i18n), en community.roles.
const riderList = [
  { name: "Iballa Ruano", instagram: "iballa_ruano_moreno" },
  { name: "Foil Only", instagram: "foilonly" },
  { name: "Moritz Mauch", instagram: "moritzmauch" },
  { name: "Miguel Chapuis", instagram: "miguelitochapuis" },
  { name: "Ramón Sánchez", instagram: "ramonfoil" },
];
const riders = riderList.map((r) => ({
  ...r,
  role: t.community.roles[r.name] ?? "",
  url: r.instagram ? `https://www.instagram.com/${r.instagram}/` : "",
  // Foto de perfil de Instagram (96x96) en public/riders/{instagram}.webp
  photo: r.instagram ? `/riders/${r.instagram}.webp` : "",
  initials: r.name.replace("@", "").split(" ").map((w) => w[0]).join("").slice(0, 2),
}));

// Fotos sacadas del Instagram de la comunidad. Para cambiarlas, sustituye los archivos de public/fotos/
const files = [
  { src: "/fotos/run-en-el-agua.jpg", w: 388, h: 447 },
  { src: "/fotos/antes-del-run.jpg", w: 388, h: 447 },
  { src: "/fotos/despues-del-run.jpg", w: 385, h: 447 },
];
const photos = files.map((f, i) => ({ ...f, ...t.community.photos[i] }));
---

<section aria-labelledby="comunidad-title" class="border-y-2 border-ink bg-sun py-24">
  <div class={container}>
    <div class="grid gap-12 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p data-reveal class={`${stickerBase} -rotate-2 bg-paper`}>{t.community.sticker}</p>
        <h2 id="comunidad-title" data-reveal style="--d: 80ms" class={h2}>{t.community.title}</h2>
        <p data-reveal style="--d: 160ms" class="mt-6 max-w-[680px] text-lg text-ink/80">
          {t.community.lead}
        </p>
        <div data-reveal style="--d: 240ms" class="mt-8">
          <a href={site.instagram} target="_blank" rel="noopener" class={btnSecondary}>
            <Icon name="instagram" class="size-5" />
            <span>{t.community.instagram} {site.instagramHandle}</span>
          </a>
        </div>
      </div>

      <div class="lg:col-span-5">
        <p data-reveal class="text-sm font-semibold uppercase tracking-wide">{t.community.ridersLabel}</p>
        <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
          {
            riders.map((rider, i) => (
              <li data-reveal style={`--d: ${120 + i * 80}ms`} class={i % 2 ? "rotate-1" : "-rotate-1"}>
                {rider.url ? (
                  <a
                    href={rider.url}
                    target="_blank"
                    rel="noopener"
                    aria-label={`${rider.name}, Instagram @${rider.instagram}`}
                    class="group flex items-center gap-4 rounded-2xl border-2 border-ink bg-paper p-4 shadow-hard transition-all duration-700 ease-fluid hover:-translate-y-0.5 hover:bg-white"
                  >
                    {rider.photo ? (
                      <img src={rider.photo} width="96" height="96" alt="" loading="lazy" decoding="async" class="size-12 shrink-0 rounded-full border-2 border-ink bg-blue object-cover" />
                    ) : (
                      <span class="flex size-12 shrink-0 items-center justify-center rounded-full border-2 border-ink bg-blue font-display text-xl uppercase text-cream" aria-hidden="true">{rider.initials}</span>
                    )}
                    <span class="min-w-0 flex-1">
                      <span class="block font-display text-2xl uppercase leading-none">{rider.name}</span>
                      {rider.role && <span class="mt-1 block text-sm text-ink/60">{rider.role}</span>}
                      <span class="mt-1 block truncate text-sm font-semibold text-blue">@{rider.instagram}</span>
                    </span>
                    <Icon name="instagram" class="size-5 shrink-0 transition-transform duration-700 ease-fluid group-hover:-rotate-12" />
                  </a>
                ) : (
                  <div class="flex items-center gap-4 rounded-2xl border-2 border-ink bg-paper p-4 shadow-hard">
                    <span class="flex size-12 shrink-0 items-center justify-center rounded-full border-2 border-ink bg-blue font-display text-xl uppercase text-cream" aria-hidden="true">{rider.initials}</span>
                    <span class="min-w-0 flex-1">
                      <span class="block font-display text-2xl uppercase leading-none">{rider.name}</span>
                      {rider.role && <span class="mt-1 block text-sm text-ink/60">{rider.role}</span>}
                    </span>
                  </div>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <ul class="mt-16 grid gap-8 sm:grid-cols-3">
      {
        photos.map((photo, i) => (
          <li data-reveal style={`--d: ${i * 100}ms`} class={`${["-rotate-2", "rotate-1", "-rotate-1"][i]} transition-transform duration-700 ease-fluid hover:rotate-0`}>
            <figure class="tape rounded-2xl border-2 border-ink bg-paper p-2 shadow-hard">
              <img src={photo.src} width={photo.w} height={photo.h} alt={photo.alt} loading="lazy" decoding="async" class="aspect-[4/5] h-auto w-full rounded-lg border-2 border-ink object-cover" />
              <figcaption class="px-2 pb-1 pt-2 font-display text-xl uppercase leading-none">{photo.caption}</figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>
