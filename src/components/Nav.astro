---
import Logo from "./Logo.astro";
import { nav } from "../config";
import { btnSmall } from "../ui";

const menu = [...nav, { href: "/#unete", label: "Únete", id: "unete" }];
const fluid = "transition-all duration-700 ease-fluid";
---

<a
  href="#contenido"
  class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-sun focus:px-3 focus:py-2 focus:text-sm focus:font-semibold focus:text-ink"
>Saltar al contenido</a>

<header data-nav data-open="false" class="group/nav fixed inset-x-0 top-0 z-50 px-4">
  <nav
    aria-label="Principal"
    class="relative z-10 mx-auto mt-6 flex w-max max-w-full items-center gap-4 rounded-full border-2 border-ink bg-cream/90 py-1 pl-2 pr-1 shadow-hard-sm backdrop-blur-xl md:gap-6"
  >
    <a href="/" class="flex items-center gap-2" aria-label="Alisios DW, ir al inicio">
      <Logo class="size-10 shrink-0 transition-transform duration-700 ease-fluid hover:-rotate-12" eager />
      <span class="font-display text-xl uppercase leading-none">Alisios DW</span>
    </a>

    <ul class="hidden items-center gap-1 lg:flex">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              data-spy={item.id}
              class={`rounded-full px-3 py-2 text-sm font-semibold ${fluid} hover:bg-ink/5 aria-[current=true]:bg-sun`}
            >{item.label}</a>
          </li>
        ))
      }
    </ul>

    <a href="/#unete" class={`${btnSmall} hidden sm:inline-flex`}>Únete</a>

    <button
      type="button"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="menu-movil"
      aria-label="Abrir menú"
      class={`group relative size-10 shrink-0 rounded-full bg-ink ${fluid} hover:bg-blue active:scale-[0.98] lg:hidden`}
    >
      <span class={`absolute inset-0 m-auto block h-0.5 w-4 -translate-y-1 rounded-full bg-cream ${fluid} group-aria-expanded:translate-y-0 group-aria-expanded:rotate-45`}></span>
      <span class={`absolute inset-0 m-auto block h-0.5 w-4 translate-y-1 rounded-full bg-cream ${fluid} group-aria-expanded:translate-y-0 group-aria-expanded:-rotate-45`}></span>
    </button>
  </nav>

  <div
    id="menu-movil"
    class={`invisible fixed inset-0 bg-blue/90 opacity-0 backdrop-blur-3xl ${fluid} group-data-[open=true]/nav:visible group-data-[open=true]/nav:opacity-100 lg:hidden`}
  >
    <ul class="flex h-full flex-col justify-center gap-4 px-6">
      {
        menu.map((item, i) => (
          <li class="overflow-hidden">
            <a
              href={item.href}
              data-menu-link
              style={`transition-delay: ${100 + i * 50}ms`}
              class={`block translate-y-12 font-display text-6xl uppercase leading-none text-cream opacity-0 ${fluid} hover:text-sun group-data-[open=true]/nav:translate-y-0 group-data-[open=true]/nav:opacity-100`}
            >{item.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</header>
