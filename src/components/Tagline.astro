---
// Frase grande sobre negro: cada palabra se enciende una a una al entrar en pantalla (ver scripts/main.ts).
// Cada elemento es un tramo con sentido propio; accent marca el remate en amarillo.
const lines = [
  { text: "En Gran Canaria", accent: false },
  { text: "el viento no falta.", accent: false },
  { text: "Lo que faltaba", accent: false },
  { text: "era con quién bajarlo.", accent: true },
];
---

<section aria-label="Lo que nos mueve" class="bg-ink py-24">
  <div class="mx-auto w-full max-w-6xl px-4 md:px-6">
    <p class="max-w-[680px] font-display text-5xl uppercase leading-none md:text-7xl">
      {
        lines.map((line) => (
          <span class="block">
            {line.text.split(" ").map((word) => (
              <>
                <span data-word data-accent={line.accent ? "" : undefined}>{word}</span>{" "}
              </>
            ))}
          </span>
        ))
      }
    </p>
  </div>
</section>
