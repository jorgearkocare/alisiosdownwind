---
import Icon from "./Icon.astro";
import type { IconName } from "../icons";
import { card, container, h2, section, sticker } from "../ui";
import { useI18n } from "../i18n";

const { t } = useI18n(Astro.url);
const icons: IconName[] = ["car", "lifebuoy", "trend"];
const items = t.why.items.map((item, i) => ({ ...item, icon: icons[i] }));
---

<section id="por-que" aria-labelledby="por-que-title" class={section}>
  <div class={container}>
    <p data-reveal class={`${sticker} rotate-1`}>{t.why.sticker}</p>
    <h2 id="por-que-title" data-reveal style="--d: 80ms" class={h2}>
      {t.why.title}
    </h2>

    <ul class="mt-12 grid gap-8 md:grid-cols-3">
      {
        items.map((item, i) => (
          <li data-reveal style={`--d: ${120 + i * 80}ms`} class={`${card} flex flex-col p-6`}>
            <span class="flex size-12 items-center justify-center rounded-full border-2 border-ink bg-sun">
              <Icon name={item.icon} class="size-6" />
            </span>
            <h3 class="mt-6 font-display text-3xl uppercase leading-none">{item.title}</h3>
            <p class="mt-4 text-sm font-semibold uppercase tracking-wide text-ink/50">{t.why.alone}</p>
            <p class="mt-2 text-base text-ink/70">{item.problem}</p>
            <div class="my-6 border-t-2 border-dashed border-ink/30" aria-hidden="true"></div>
            <p class="text-sm font-semibold uppercase tracking-wide text-blue">{t.why.group}</p>
            <p class="mt-2 text-base font-medium">{item.solution}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
