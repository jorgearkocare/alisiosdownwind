---
import Icon from "./Icon.astro";
import type { IconName } from "../icons";
import { card, container, h2, section, sticker } from "../ui";

const items: { icon: IconName; title: string; problem: string; solution: string }[] = [
  {
    icon: "car",
    title: "Logística",
    problem: "Un downwind empieza en un sitio y termina en otro. Sin un segundo coche esperando en la llegada, no hay run.",
    solution: "Cuadramos coches en el grupo: dejamos unos en la llegada y subimos juntos a la salida.",
  },
  {
    icon: "lifebuoy",
    title: "Seguridad",
    problem: "Si rompes un foil o te quedas sin piernas a mitad de ruta, estás solo frente a kilómetros de costa.",
    solution: "Salimos juntos, con la ruta compartida y riders que conocen cada entrada y salida del mar.",
  },
  {
    icon: "trend",
    title: "Progresión",
    problem: "Aprender a leer el swell a base de prueba y error lleva temporadas enteras.",
    solution: "Haces el run al lado de riders con más horas, ves su línea y copias lo que funciona.",
  },
];
---

<section id="por-que" aria-labelledby="por-que-title" class={section}>
  <div class={container}>
    <p data-reveal class={`${sticker} rotate-1`}>Por qué en grupo</p>
    <h2 id="por-que-title" data-reveal style="--d: 80ms" class={h2}>
      Hacer downwind solo tiene tres problemas. En grupo, ninguno.
    </h2>

    <ul class="mt-12 grid gap-8 md:grid-cols-3">
      {
        items.map((item, i) => (
          <li data-reveal style={`--d: ${120 + i * 80}ms`} class={`${card} flex flex-col p-6`}>
            <span class="flex size-12 items-center justify-center rounded-full border-2 border-ink bg-sun">
              <Icon name={item.icon} class="size-6" />
            </span>
            <h3 class="mt-6 font-display text-3xl uppercase leading-none">{item.title}</h3>
            <p class="mt-4 text-sm font-semibold uppercase tracking-wide text-ink/50">Si vas solo</p>
            <p class="mt-2 text-base text-ink/70">{item.problem}</p>
            <div class="my-6 border-t-2 border-dashed border-ink/30" aria-hidden="true"></div>
            <p class="text-sm font-semibold uppercase tracking-wide text-blue">En grupo</p>
            <p class="mt-2 text-base font-medium">{item.solution}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
