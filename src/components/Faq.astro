---
import Icon from "./Icon.astro";
import { faqs } from "../faqs";
import { container, h2, section, sticker } from "../ui";
---

<section id="faq" aria-labelledby="faq-title" class={section}>
  <div class={`${container} grid gap-12 lg:grid-cols-12`}>
    <div class="lg:col-span-4">
      <div class="lg:sticky lg:top-24">
        <p data-reveal class={`${sticker} -rotate-1`}>Preguntas frecuentes</p>
        <h2 id="faq-title" data-reveal style="--d: 80ms" class="mt-6 max-w-[680px] font-display text-5xl uppercase leading-none md:text-6xl">Lo que nos preguntáis antes del primer downwind</h2>
      </div>
    </div>

    <div class="lg:col-span-8">
      <div class="space-y-4">
        {
          faqs.map((faq) => (
            <details data-reveal class="group rounded-2xl border-2 border-ink bg-paper transition-all duration-700 ease-fluid hover:shadow-hard-sm open:shadow-hard">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 rounded-2xl p-6 text-lg font-semibold [&::-webkit-details-marker]:hidden">
                <span>{faq.q}</span>
                <span class="flex size-8 shrink-0 items-center justify-center rounded-full border-2 border-ink bg-sun transition-transform duration-700 ease-fluid group-open:rotate-45">
                  <Icon name="plus" class="size-4" />
                </span>
              </summary>
              <p class="px-6 pb-6 text-base text-ink/70">{faq.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>
