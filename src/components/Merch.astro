---
import Icon from "./Icon.astro";
import { container, h2, section, sticker } from "../ui";

// Primera tirada (diseños provisionales). Cada prenda lleva nombre propio, como una colección.
const items = [
  {
    name: "Camiseta Pez Volador",
    detail: "El logo completo en el pecho",
    bg: "bg-blue",
    garment: "tee",
  },
  {
    name: "Gorra Nordeste",
    detail: "Trucker con parche bordado del pez",
    bg: "bg-sun",
    garment: "cap",
  },
  {
    name: "Sudadera Bump",
    detail: "Para la espera en la llegada cuando refresca",
    bg: "bg-cream",
    garment: "hoodie",
  },
];
---

<section id="merch" aria-labelledby="merch-title" class={section}>
  <div class={container}>
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <p data-reveal class={`${sticker} -rotate-2`}>Colección 2026</p>
        <h2 id="merch-title" data-reveal style="--d: 80ms" class={h2}>Merch de la comunidad</h2>
        <p data-reveal style="--d: 160ms" class="mt-6 max-w-[680px] text-lg text-ink/70">
          Primera tirada limitada y en preventa: solo se fabrica lo que se reserva.
        </p>
      </div>
      <a data-reveal href="#unete" data-interest="merch" class="inline-flex shrink-0 items-center gap-2 text-base font-semibold underline decoration-sun decoration-2 underline-offset-4 transition-all duration-700 ease-fluid hover:translate-x-1 hover:decoration-blue">
        <span>Avísame de la preventa</span>
        <Icon name="arrowRight" class="size-4" />
      </a>
    </div>

    <ul class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        items.map((item, i) => (
          <li data-reveal style={`--d: ${120 + i * 80}ms`} class="group rounded-2xl border-2 border-ink bg-paper p-2 shadow-hard">
            <div class={`relative aspect-square overflow-hidden rounded-lg border-2 border-ink ${item.bg}`}>
              <svg viewBox="0 0 200 200" class="h-full w-full transition-transform duration-700 ease-fluid group-hover:-rotate-3 group-hover:scale-105" role="img" aria-label={`Boceto de ${item.name}`}>
                {item.garment === "tee" && (
                  <>
                    <path d="M72 32 L50 40 L22 62 L36 90 L54 82 L54 176 L146 176 L146 82 L164 90 L178 62 L150 40 L128 32 C122 44 112 50 100 50 C88 50 78 44 72 32 Z" fill="#f8f6ea" stroke="#0b0b09" stroke-width="3" stroke-linejoin="round" />
                    <path d="M72 32 C78 44 88 50 100 50 C112 50 122 44 128 32" fill="none" stroke="#0b0b09" stroke-width="3" />
                    <image href="/brand/logo.png" x="70" y="66" width="60" height="63" />
                  </>
                )}
                {item.garment === "cap" && (
                  <>
                    <path d="M38 128 C38 78 66 52 104 52 C142 52 164 80 164 128 Z" fill="#0b0b09" stroke="#0b0b09" stroke-width="3" stroke-linejoin="round" />
                    <path d="M118 56 C142 62 160 84 164 128 L124 128 Z" fill="#f8f6ea" stroke="#0b0b09" stroke-width="3" stroke-linejoin="round" />
                    <path d="M130 70 L150 120 M140 66 L158 112 M124 82 L134 124" stroke="#0b0b09" stroke-width="1.5" opacity="0.5" />
                    <path d="M26 128 L172 128 C172 140 158 148 140 148 L58 148 C40 148 26 140 26 128 Z" fill="#0b0b09" stroke="#0b0b09" stroke-width="3" stroke-linejoin="round" />
                    <circle cx="104" cy="52" r="5" fill="#0b0b09" />
                    <image href="/brand/mark.png" x="58" y="70" width="52" height="52" />
                  </>
                )}
                {item.garment === "hoodie" && (
                  <>
                    <path d="M74 36 L48 44 L22 72 L18 164 L42 166 L52 104 L52 180 L148 180 L148 104 L158 166 L182 164 L178 72 L152 44 L126 36 C124 22 114 12 100 12 C86 12 76 22 74 36 Z" fill="#0035d5" stroke="#0b0b09" stroke-width="3" stroke-linejoin="round" />
                    <path d="M84 38 C88 54 112 54 116 38" fill="#0b0b09" stroke="#0b0b09" stroke-width="3" />
                    <path d="M94 54 L92 76 M106 54 L108 76" stroke="#f8f6ea" stroke-width="2.5" stroke-linecap="round" />
                    <path d="M70 140 L130 140 L136 172 L64 172 Z" fill="none" stroke="#0b0b09" stroke-width="3" stroke-linejoin="round" />
                    <image href="/brand/mark.png" x="74" y="84" width="52" height="52" />
                  </>
                )}
              </svg>
              <span class="absolute right-3 top-3 rotate-3 rounded-full border-2 border-ink bg-paper px-2 py-0.5 text-xs font-semibold uppercase tracking-wide">Preventa pronto</span>
            </div>
            <div class="px-2 pb-2 pt-4">
              <h3 class="font-display text-2xl uppercase leading-none">{item.name}</h3>
              <p class="mt-2 text-sm text-ink/60">{item.detail}</p>
            </div>
          </li>
        ))
      }
    </ul>
    <p class="mt-6 text-xs text-ink/50">Bocetos provisionales. Colores y prendas definitivas en la preventa.</p>
  </div>
</section>
