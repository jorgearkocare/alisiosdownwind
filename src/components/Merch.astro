---
import Icon from "./Icon.astro";
import Sticker from "./Sticker.astro";
import { container, h2, section, sticker } from "../ui";
import { useI18n } from "../i18n";

const { t } = useI18n(Astro.url);

// Primeros diseños (maquetas, aún por definir). Las fotos están en public/merch/ (480x600).
// Nombre y descripción de cada prenda en los diccionarios (src/i18n), en merch.items, en este mismo orden.
const files = ["gorra-de-agua", "gorra-trucker", "lycra-con-capucha", "camiseta-espalda"];
const tilts = ["-rotate-1", "rotate-1", "-rotate-2", "rotate-2"];
const items = t.merch.items.map((item, i) => ({ ...item, src: `/merch/${files[i]}.jpg`, tilt: tilts[i] }));
---

<section id="merch" aria-labelledby="merch-title" class={section}>
  <div class={container}>
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <p data-reveal class={`${sticker} -rotate-2`}>{t.merch.sticker}</p>
        <h2 id="merch-title" data-reveal style="--d: 80ms" class={h2}>{t.merch.title}</h2>
        <p data-reveal style="--d: 160ms" class="mt-6 max-w-[680px] text-lg text-ink/70">
          {t.merch.lead}
        </p>
      </div>
      <a data-reveal href="#report" class="inline-flex shrink-0 items-center gap-2 text-base font-semibold underline decoration-sun decoration-2 underline-offset-4 transition-all duration-700 ease-fluid hover:translate-x-1 hover:decoration-blue">
        <span>{t.merch.cta}</span>
        <Icon name="arrowRight" class="size-4" />
      </a>
    </div>

    <ul class="mt-16 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      {
        items.map((item, i) => (
          <li data-reveal style={`--d: ${120 + i * 80}ms`} class={`group tape rounded-2xl border-2 border-ink bg-paper p-2 shadow-hard transition-transform duration-700 ease-fluid md:hover:rotate-0 ${item.tilt}`}>
            <div class="relative overflow-hidden rounded-lg border-2 border-ink bg-white">
              <img
                src={item.src}
                width="480"
                height="600"
                alt={`${t.merch.mockupOf} ${item.name}`}
                loading="lazy"
                decoding="async"
                class="aspect-[4/5] h-auto w-full object-cover transition-transform duration-700 ease-fluid group-hover:scale-105"
              />
              <Sticker text={t.merch.tag} tone={i % 2 ? "sun" : "blue"} class="absolute right-3 top-3 rotate-6" />
            </div>
            <div class="px-2 pb-2 pt-4">
              <h3 class="font-display text-2xl uppercase leading-none">{item.name}</h3>
              <p class="mt-2 text-sm text-ink/60">{item.detail}</p>
            </div>
          </li>
        ))
      }
    </ul>
    <p class="mt-8 text-sm text-ink/60">{t.merch.note}</p>
  </div>
</section>
