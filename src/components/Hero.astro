---
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import SpinBadge from "./SpinBadge.astro";
import Sticker from "./Sticker.astro";
import { site } from "../config";
import { btnPrimary, container, sticker } from "../ui";
import { useI18n } from "../i18n";

const { t } = useI18n(Astro.url);
---

<section aria-labelledby="hero-title" class="relative isolate overflow-x-clip pb-16 pt-24">
  <div class={`${container} mt-16`}>
    <div class="grid items-center gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p data-reveal class={`${sticker} -rotate-2`}>
          <Icon name="mapPin" class="size-4" />
          <span>{t.hero.sticker}</span>
        </p>

        <h1 id="hero-title" data-reveal style="--d: 80ms" class="isolate mt-6 max-w-[680px] font-display text-6xl uppercase leading-none sm:text-7xl">
          {t.hero.title[0]}<br /> {t.hero.title[1]}<br /> <span class="relative inline-block text-blue">
            {t.hero.titleAccent}
            <svg viewBox="0 0 300 24" preserveAspectRatio="none" aria-hidden="true" class="scribble absolute -bottom-3 left-0 -z-10 h-5 w-full overflow-visible text-sun md:-bottom-4 md:h-6">
              <path pathLength="1" d="M4 15 C 52 7, 118 5, 178 9 S 268 15, 296 8" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" />
              <path pathLength="1" d="M22 20 C 96 13, 190 14, 284 17" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" />
            </svg>
          </span>
        </h1>

        <p data-reveal style="--d: 160ms" class="mt-6 max-w-[680px] text-lg text-ink/70">
          {t.hero.lead}
        </p>

        <div data-reveal style="--d: 240ms" class="mt-8 flex flex-wrap items-center gap-4">
          <a href="#unete" class={btnPrimary}>
            <span>{t.hero.cta}</span>
            <Icon name="arrowRight" class="size-4" />
          </a>
          <span class="text-sm font-semibold text-ink/60">{t.hero.free}</span>
        </div>

        <div data-reveal style="--d: 320ms" class="mt-12 flex items-start gap-3 text-sm text-ink/70">
          <Icon name="users" class="mt-0.5 size-5 shrink-0 text-blue" />
          <p>
            {t.hero.proof} <a href={site.instagram} target="_blank" rel="noopener" class="font-semibold text-ink underline decoration-sun decoration-2 underline-offset-4 transition-colors duration-700 ease-fluid hover:decoration-blue">{site.instagramHandle}</a>
          </p>
        </div>
      </div>

      <div data-reveal style="--d: 200ms" class="relative isolate lg:col-span-5">
        <div class="halftone pointer-events-none absolute -inset-8 -z-10" aria-hidden="true"></div>
        <SpinBadge class="absolute -left-2 top-0 z-10 -rotate-12 sm:left-4" />
        <Logo full eager alt={t.hero.logoAlt} class="bob mx-auto h-auto w-full max-w-[460px]" />

        <figure class="relative mt-6 ml-auto max-w-[320px] rotate-2 rounded-2xl border-2 border-ink bg-paper p-4 shadow-hard">
          <Sticker text="Downwind costa este" tone="blue" class="absolute -left-6 -top-6 -rotate-6" />
          <figcaption class="mt-4 flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-ink/60">
            <Icon name="whatsapp" class="size-4 text-blue" />
            <span>{t.hero.alertLabel}</span>
          </figcaption>
          <p class="mt-2 text-sm">
            {t.hero.alert}
          </p>
        </figure>
      </div>
    </div>
  </div>
</section>
