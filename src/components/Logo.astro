---
// Marca del pez sobre el foil (recorte del logo completo). El logo entero está en /brand/logo.png
interface Props {
  class?: string;
  full?: boolean;
  alt?: string;
  eager?: boolean;
}

const { class: className = "size-10", full = false, alt = "", eager = false } = Astro.props;
const src = full ? "/brand/logo.png" : "/brand/mark.png";
const [width, height] = full ? [960, 1004] : [512, 512];
---

<img src={src} width={width} height={height} alt={alt} class={className} loading={eager ? "eager" : "lazy"} decoding="async" />
